<style>
    .sidebar {
        position: fixed;
        left: 0;
        top: 0;
        height: 100vh;
        width: 250px;
        background: #1a1a1a;
        color: white;
        transition: transform 0.3s ease;
        z-index: 1000;
    }

    .profile-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 1rem;
    }

    .profile-pic-container {
        width: 150px;
        height: 150px;
        margin: 0 auto;
        border-radius: 50%;
        overflow: hidden;
    }

    .profile-pic {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .nav-content {
        padding: 1rem;
    }

    .nav-links {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .nav-link {
        color: white;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: 0.25rem;
        transition: background-color 0.2s;
        font-size: 1.2rem;
    }

    .nav-link:hover {
        background-color: #333;
    }

    .blog-link {
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.2rem;
    }

    .blog-subtitle {
        font-size: 0.8rem;
        opacity: 0.8;
    }

    .social-links {
        display: flex;
        gap: 1rem;
        margin-top: 0.5rem;
    }

    .social-icon {
        width: 24px;
        height: 24px;
        color: #666;
        transition: color 0.2s ease;
    }

    .social-icon:hover {
        color: #333;
    }

    .toggle-nav {
        display: none;
        position: absolute;
        right: -48px;
        top: 1rem;
        background: #1a1a1a;
        border: none;
        padding: 1rem 0.5rem;
        cursor: pointer;
        border-radius: 0.25rem 0.25rem 0.25rem 0.25rem;
    }

    .hamburger {
        display: block;
        width: 24px;
        height: 2px;
        background: white;
        position: relative;
    }

    .hamburger::before,
    .hamburger::after {
        content: '';
        position: absolute;
        width: 24px;
        height: 2px;
        background: white;
        left: 0;
    }

    .hamburger::before {
        top: -6px;
    }

    .hamburger::after {
        bottom: -6px;
    }

    .name {
        font-size: 1.5rem;
        margin: 1rem 0 0.5rem 0;
        color: #ccc;
    }

    .nav-divider {
        border: none;
        height: 1px;
        background-color: #666;
        margin: 1rem 0;
        width: 100%;
    }

    @media (max-width: 768px) {
        .sidebar {
            transform: translateX(-100%);
        }

        .sidebar.open {
            transform: translateX(0);
        }

        .toggle-nav {
            display: block;
        }
    }
</style>

<script>
    const toggleNav = document.querySelector('.toggle-nav');
    const sidebar = document.querySelector('.sidebar');

    toggleNav?.addEventListener('click', () => {
        sidebar?.classList.toggle('open');
    });
</script>
