<style>
    .sidebar {
        position: fixed;
        left: 0;
        top: 0;
        height: 100vh;
        width: 250px;
        background: #1a1a1a;
        color: white;
        transition: transform 0.3s ease;
        z-index: 1000;
        display: flex;
        flex-direction: column;
    }

    .mobile-header {
        display: none;
    }

    .profile-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 1rem;
    }

    .profile-info {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .profile-pic-container {
        width: 150px;
        height: 150px;
        margin: 0 auto;
        border-radius: 50%;
        overflow: hidden;
    }

    .profile-pic {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .nav-content {
        padding: 1rem;
        flex-grow: 1;
        overflow-y: auto;
    }

    .nav-links {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .nav-link {
        color: white;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: 0.25rem;
        transition: background-color 0.2s;
        font-size: 1.2rem;
    }

    .nav-link:hover {
        background-color: #333;
    }

    .blog-link {
        display: flex;
        flex-direction: column;
    }

    .blog-subtitle {
        font-size: 0.8rem;
        opacity: 0.7;
        margin-top: 0.2rem;
    }

    .social-links {
        display: flex;
        gap: 1rem;
        margin-top: 0.5rem;
    }

    .social-icon {
        width: 18px;
        height: 18px;
        color: white;
    }

    .nav-divider {
        width: 80%;
        border: none;
        border-top: 1px solid #333;
        margin-bottom: 1rem auto;
    }

    .toggle-nav {
        display: none;
    }

    @media (max-width: 768px) {
        .sidebar {
            position: fixed;
            height: auto;
            width: 100%;
        }

        .mobile-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            background: #1a1a1a;
            padding: 0.5rem 1rem;
            box-sizing: border-box;
        }

        .profile-section {
            flex-direction: row;
            justify-content: flex-start;
            padding: 0;
            gap: 1rem;
        }

        .profile-pic-container {
            width: 50px;
            height: 50px;
            margin: 0;
        }

        .profile-info {
            align-items: flex-start;
        }

        .name {
            margin: 0;
            font-size: 1.2rem;
        }

        .social-links {
            margin-top: 0.25rem;
        }

        .nav-content {
            display: none;
            position: fixed;
            top: 71px; /* Height of mobile header */
            left: 0;
            width: 100%;
            background: #1a1a1a;
            padding: 0;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            max-height: calc(100vh - 71px);
            overflow-y: auto;
        }

        .nav-links {
            padding: 1rem;
        }

        .nav-link {
            padding: 0.75rem 1rem;
            border-radius: 0;
            border-bottom: 1px solid #333;
        }

        .nav-link:last-child {
            border-bottom: none;
        }

        .desktop-only {
            display: none;
        }

        .toggle-nav {
            display: block;
            background: none;
            border: none;
            cursor: pointer;
            padding: 0.5rem;
            margin-left: 1rem;
        }

        .hamburger {
            display: block;
            width: 24px;
            height: 2px;
            background: white;
            position: relative;
            transition: background-color 0.3s;
        }

        .hamburger::before,
        .hamburger::after {
            content: "";
            position: absolute;
            left: 0;
            width: 24px;
            height: 2px;
            background: white;
            transition: transform 0.3s;
        }

        .hamburger::before {
            top: -8px;
        }

        .hamburger::after {
            top: 8px;
        }

        .sidebar.menu-open .hamburger {
            background: transparent;
        }

        .sidebar.menu-open .hamburger::before {
            transform: translateY(8px) rotate(45deg);
        }

        .sidebar.menu-open .hamburger::after {
            transform: translateY(-8px) rotate(-45deg);
        }

        .sidebar.menu-open .nav-content {
            display: block;
        }
    }
</style>

<script>
    const sidebar = document.querySelector(".sidebar");
    const toggleNav = document.querySelector(".toggle-nav");
    const navContent = document.querySelector(".nav-content");

    toggleNav?.addEventListener("click", (event) => {
        event.stopPropagation();
        sidebar?.classList.toggle("menu-open");
    });

    // Close menu when clicking outside
    document.addEventListener("click", (event) => {
        const target = event.target as Node;
        if (
            sidebar?.classList.contains("menu-open") &&
            !sidebar.contains(target)
        ) {
            sidebar.classList.remove("menu-open");
        }
    });

    // Prevent clicks inside the nav-content from closing the menu
    navContent?.addEventListener("click", (event) => {
        event.stopPropagation();
    });
</script>
