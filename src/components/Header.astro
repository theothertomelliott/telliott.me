---
import Navigation from './Navigation.astro';
import Menu from './Menu.astro';
import ThemeIcon from './ThemeIcon.astro';
---
<header>
    <nav>
        <a href="/" class="site-title">telliott.me</a>
        <div class="nav-center">
            <Menu/>
            <Navigation />
        </div>
        <div class="theme-toggle">
            <ThemeIcon />
        </div>
    </nav>
</header>

<style>
  nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .nav-center {
    justify-self: center;
  }

  .site-title {
    font-weight: bold;
    font-size: 1.25rem;
    text-decoration: none;
    color: inherit;
  }

  .theme-toggle {
    justify-self: end;
  }
</style>
