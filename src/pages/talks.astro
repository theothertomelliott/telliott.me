---
import Layout from '../layouts/BaseLayout.astro';
import '../styles/talks.css';

import { getCollection } from 'astro:content';
import Talk from '../components/Talk.astro';
// Get all talks and sort by date (descending)
const talks = await getCollection('talks');
const sortedTalks = talks.sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<Layout pageTitle="Talks">
    <h1>Talks</h1>
    
    <div>
      {sortedTalks.map((talk) => (
        <Talk talk={talk} />
      ))}
    </div>
</Layout>
