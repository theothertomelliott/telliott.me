---
import Layout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Get all talks and sort by date (descending)
const talks = await getCollection('talks');
const sortedTalks = talks.sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<Layout title="Talks">
  <main style="max-width: 1200px; margin: 0 auto; padding: 2rem 1rem;">
    <h1 style="font-size: 2.5rem; font-weight: bold; margin-bottom: 2rem;">Talks</h1>
    
    <div style="display: flex; flex-direction: column; gap: 3rem;">
      {sortedTalks.map((talk) => (
        <article style="border-bottom: 1px solid #e5e7eb; padding-bottom: 2rem;">
          <div style="margin-bottom: 1rem;">
            <h2 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.5rem;">{talk.data.title}</h2>
            <p style="color: #6b7280; font-size: 0.875rem;">{talk.data.event} • {talk.data.date}</p>
          </div>
          
          <div style="margin-bottom: 1rem;">
            <p style="color: #374151; line-height: 1.6;">{talk.data.description}</p>
          </div>
          
          <div style="margin-bottom: 1rem; display: flex; gap: 1rem;">
            <a 
              href={talk.data.slides_url} 
              target="_blank" 
              rel="noopener noreferrer"
              style="padding: 0.5rem 1rem; background-color: #3b82f6; color: white; text-decoration: none; border-radius: 0.375rem; font-size: 0.875rem;"
            >
              Slides
            </a>
            {talk.data.video_url && (
              <a 
                href={talk.data.video_url} 
                target="_blank" 
                rel="noopener noreferrer"
                style="padding: 0.5rem 1rem; background-color: #ef4444; color: white; text-decoration: none; border-radius: 0.375rem; font-size: 0.875rem;"
              >
                Video
              </a>
            )}
          </div>

        </article>
      ))}
    </div>
  </main>
</Layout>
